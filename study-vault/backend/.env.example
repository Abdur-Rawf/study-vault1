# Copy this file to .env (local) or .env.cloud (to set up the cloud database).
# Never commit .env files.

# ---- MySQL connection ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=study_vault

# Cloud databases (Aiven etc.) need SSL. Local MySQL: leave this as false.
# If true, put the downloaded certificate in backend/ca.pem
DB_SSL=false

# ---- Security ----
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# ---- Server ----
PORT=4000

# ---- Chairman account created by `seed.js` ----
CHAIRMAN_NAME=Chairman
CHAIRMAN_EMAIL=chairman@mbstu.ac.bd
CHAIRMAN_PASSWORD=change_this_password
